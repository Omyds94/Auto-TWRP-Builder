# Blackview Active 5 (ums9230_6h10) - TWRP 14.1
# Verified UFS by-name paths. Slot-select entries resolve to the active A/B slot.
# Image partitions are backup-enabled; flashing is intentionally not enabled for vendor_boot/vbmeta.

/boot                  emmc    /dev/block/by-name/boot                  flags=display=Boot;slotselect;backup=1
/init_boot             emmc    /dev/block/by-name/init_boot             flags=display=Init_Boot;slotselect;backup=1
/vendor_boot           emmc    /dev/block/by-name/vendor_boot           flags=display=Vendor_Boot;slotselect;backup=1
/dtbo                  emmc    /dev/block/by-name/dtbo                  flags=display=DTBO;slotselect;backup=1
/vbmeta                emmc    /dev/block/by-name/vbmeta                flags=display=VBMeta;slotselect;backup=1
/vbmeta_system         emmc    /dev/block/by-name/vbmeta_system         flags=display=VBMeta_System;slotselect;backup=1
/vbmeta_vendor         emmc    /dev/block/by-name/vbmeta_vendor         flags=display=VBMeta_Vendor;slotselect;backup=1
/vbmeta_product        emmc    /dev/block/by-name/vbmeta_product        flags=display=VBMeta_Product;slotselect;backup=1
/vbmeta_odm            emmc    /dev/block/by-name/vbmeta_odm            flags=display=VBMeta_ODM;slotselect;backup=1
/vbmeta_system_ext     emmc    /dev/block/by-name/vbmeta_system_ext     flags=display=VBMeta_System_Ext;slotselect;backup=1

# Dynamic partitions (EROFS, inside super). No ext4 fallback is advertised.
/system                erofs   system                                  flags=display=System;logical;slotselect
/system_ext            erofs   system_ext                              flags=display=System_Ext;logical;slotselect
/vendor                erofs   vendor                                 flags=display=Vendor;logical;slotselect
/odm                   erofs   odm                                    flags=display=ODM;logical;slotselect
/product               erofs   product                                flags=display=Product;logical;slotselect
/vendor_dlkm           erofs   vendor_dlkm                             flags=display=Vendor_DLKM;logical;slotselect
/system_dlkm           erofs   system_dlkm                             flags=display=System_DLKM;logical;slotselect

# Physical UFS filesystems. /metadata is required by the metadata-encryption key directory.
/metadata              f2fs    /dev/block/by-name/metadata              flags=display=Metadata;fsflags=nodev,noatime,nosuid
/data                  f2fs    /dev/block/by-name/userdata              flags=display=Data;keydirectory=/metadata/vold/metadata_encryption;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;fsflags=noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,inline_xattr,inline_data,inlinecrypt,fsync_mode=nobarrier,atgc,reservedsize=128M,checkpoint=fs
/cache                 f2fs    /dev/block/by-name/cache                 flags=display=Cache;fsflags=noatime,nosuid,nodev,discard
